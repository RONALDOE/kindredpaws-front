# URL del backend real (ver GUIA-FRONTEND.md). Vite proxea /api hacia esta URL en desarrollo.
VITE_API_URL=https://kindredpaws-back.onrender.com

# Cloudinary: subida de imágenes de reportes desde el navegador (unsigned upload preset).
# Cloud Name: Dashboard de Cloudinary (arriba a la izquierda).
# Upload Preset: Settings > Upload > Upload presets > Add upload preset > Signing Mode = Unsigned.
VITE_CLOUDINARY_CLOUD_NAME=zaesokpr
VITE_CLOUDINARY_UPLOAD_PRESET=yeatea
